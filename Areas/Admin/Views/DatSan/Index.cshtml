@model IEnumerable<DatSanBanh.Models.DatSan>
@{
    ViewData["Title"] = "Quản lý đặt sân";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    string? tt = ViewBag.TrangThaiHienTai as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-bold mb-0"><i class="bi bi-calendar2-check text-success me-2"></i>Danh Sách Phiếu Đặt Sân</h5>
    <div class="btn-group btn-group-sm">
        <a asp-action="Index" class="btn @(string.IsNullOrEmpty(tt) ? "btn-dark" : "btn-outline-dark")">Tất cả</a>
        <a asp-action="Index" asp-route-trangThai="ChoThanhToan" class="btn @(tt == "ChoThanhToan" ? "btn-warning" : "btn-outline-warning")">Chờ cọc</a>
        <a asp-action="Index" asp-route-trangThai="DaCoc" class="btn @(tt == "DaCoc" ? "btn-info" : "btn-outline-info")">Đã cọc</a>
        <a asp-action="Index" asp-route-trangThai="DaNhanSan" class="btn @(tt == "DaNhanSan" ? "btn-primary" : "btn-outline-primary")">Đang đá</a>
        <a asp-action="Index" asp-route-trangThai="HoanThanh" class="btn @(tt == "HoanThanh" ? "btn-success" : "btn-outline-success")">Hoàn thành</a>
        <a asp-action="Index" asp-route-trangThai="DaHuy" class="btn @(tt == "DaHuy" ? "btn-secondary" : "btn-outline-secondary")">Đã hủy</a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Mã</th>
                    <th>Khách hàng</th>
                    <th>Sân</th>
                    <th>Ngày &amp; Giờ</th>
                    <th>Tổng tiền</th>
                    <th>Cọc (30%)</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Duyệt nhanh</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">#@item.MaDatSan</td>
                        <td>
                            <div class="fw-semibold">@item.MaNguoiDungNavigation?.HoTen</div>
                            <small class="text-muted">@item.MaNguoiDungNavigation?.SoDienThoai</small>
                        </td>
                        <td class="fw-semibold">@item.MaSanNavigation?.TenSan</td>
                        <td>
                            <div>@item.NgayDat?.ToString("dd/MM/yyyy")</div>
                            <span class="badge bg-light text-dark border">@item.KhungGioText</span>
                        </td>
                        <td class="fw-bold text-success">@item.TongTien.ToString("N0")đ</td>
                        <td class="text-danger fw-semibold">@item.TienCoc.ToString("N0")đ</td>
                        <td>
                            @if (item.TrangThai == "ChoThanhToan")
                            {
                                <span class="badge bg-warning text-dark">Chờ thanh toán cọc</span>
                            }
                            else if (item.TrangThai == "DaCoc")
                            {
                                <span class="badge bg-info text-dark">Đã cọc</span>
                            }
                            else if (item.TrangThai == "DaNhanSan")
                            {
                                <span class="badge bg-primary">Đã nhận sân</span>
                            }
                            else if (item.TrangThai == "HoanThanh")
                            {
                                <span class="badge bg-success">Hoàn thành</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Đã hủy</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (item.TrangThai == "ChoThanhToan")
                            {
                                <form asp-action="DoiTrangThai" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.MaDatSan" />
                                    <input type="hidden" name="trangThaiMoi" value="DaCoc" />
                                    <button type="submit" class="btn btn-success btn-sm">Duyệt đã cọc</button>
                                </form>
                                <form asp-action="DoiTrangThai" method="post" class="d-inline"
                                      onsubmit="return confirm('Hủy phiếu #@item.MaDatSan?');">
                                    <input type="hidden" name="id" value="@item.MaDatSan" />
                                    <input type="hidden" name="trangThaiMoi" value="DaHuy" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Hủy</button>
                                </form>
                            }
                            else if (item.TrangThai == "DaCoc")
                            {
                                <form asp-action="DoiTrangThai" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.MaDatSan" />
                                    <input type="hidden" name="trangThaiMoi" value="DaNhanSan" />
                                    <button type="submit" class="btn btn-primary btn-sm">Khách nhận sân</button>
                                </form>
                            }
                            else if (item.TrangThai == "DaNhanSan")
                            {
                                <form asp-action="DoiTrangThai" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.MaDatSan" />
                                    <input type="hidden" name="trangThaiMoi" value="HoanThanh" />
                                    <button type="submit" class="btn btn-success btn-sm">Hoàn thành</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>