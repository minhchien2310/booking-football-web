@model IEnumerable<DatSanBanh.Models.SanBong>
@{
    ViewData["Title"] = "Quản lý sân bóng";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <span class="fw-bold">Danh sách sân hiện có (@Model.Count())</span>
        <a asp-action="Them" class="btn btn-success btn-sm fw-semibold">
            <i class="bi bi-plus-circle me-1"></i> Thêm sân mới
        </a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã</th>
                    <th>Tên sân</th>
                    <th>Loại sân</th>
                    <th>Mô tả</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>#@item.MaSan</td>
                        <td class="fw-semibold">@item.TenSan</td>
                        <td><span class="badge bg-dark">Sân @item.LoaiSan</span></td>
                        <td class="text-muted small">@item.MoTa</td>
                        <td>
                            @if (item.TrangThai == "HoatDong")
                            {
                                <span class="badge bg-success">Hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Bảo trì</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Sua" asp-route-id="@item.MaSan" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-pencil-square"></i> Sửa
                            </a>
                            <form asp-action="Xoa" asp-route-id="@item.MaSan" method="post" class="d-inline"
                                  onsubmit="return confirm('Bạn có chắc muốn xóa @item.TenSan không?');">
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-trash"></i> Xóa
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>