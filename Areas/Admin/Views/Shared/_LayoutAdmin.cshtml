@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@using DatSanBanh.Models
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var session = Context.Session.GetString("NguoiDung");
    NguoiDung? nd = session != null ? JsonConvert.DeserializeObject<NguoiDung>(session) : null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Trị Sân Bóng</title>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            font-family: 'Be Vietnam Pro', sans-serif;
            background-color: #f3f4f6;
        }

        .sidebar {
            width: 250px;
            min-height: 100vh;
            background-color: #0b0f13;
            border-right: 2px solid #16a34a;
        }

            .sidebar .nav-link {
                color: #cbd5e1;
                padding: 12px 18px;
                border-radius: 8px;
                margin-bottom: 4px;
                font-weight: 500;
            }

                .sidebar .nav-link:hover {
                    background-color: rgba(22, 163, 74, 0.15);
                    color: #ffffff;
                }

                .sidebar .nav-link.active {
                    background-color: #16a34a;
                    color: #ffffff;
                    font-weight: 600;
                }
    </style>
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar bên trái -->
        <aside class="sidebar p-3 d-flex flex-column text-white">
            <a class="text-white text-decoration-none fw-bold fs-5 mb-4 d-flex align-items-center gap-2"
               asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                <span class="bg-success px-2 py-1 rounded-2"><i class="bi bi-shield-lock"></i></span>
                <span>ADMIN <span class="text-success">SÂN BÓNG</span></span>
            </a>

            <ul class="nav flex-column mb-auto">
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Dashboard" ? "active" : "")"
                       asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-speedometer2 me-2"></i> Tổng quan
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentController == "SanBong" ? "active" : "")"
                       asp-area="Admin" asp-controller="SanBong" asp-action="Index">
                        <i class="bi bi-dribbble me-2"></i> Quản lý sân bóng
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentController == "DatSan" ? "active" : "")"
                       asp-area="Admin" asp-controller="DatSan" asp-action="Index">
                        <i class="bi bi-calendar2-check me-2"></i> Quản lý đặt sân
                    </a>
                </li>
            </ul>

            <hr class="border-secondary" />
            <a class="btn btn-outline-light btn-sm w-100 mb-2" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-arrow-left-circle me-1"></i> Về trang khách hàng
            </a>
            <a class="btn btn-outline-danger btn-sm w-100" asp-area="" asp-controller="TaiKhoan" asp-action="DangXuat">
                <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
            </a>
        </aside>

        <!-- Nội dung chính bên phải -->
        <div class="flex-grow-1 d-flex flex-column">
            <header class="bg-white border-bottom px-4 py-3 d-flex justify-content-between align-items-center shadow-sm">
                <h5 class="mb-0 fw-bold text-dark">@ViewData["Title"]</h5>
                <div class="small text-muted">
                    <i class="bi bi-person-badge text-success me-1"></i> Xin chào, <strong class="text-dark">@nd?.HoTen</strong>
                </div>
            </header>

            <main class="p-4">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success border-0 border-start border-4 border-success shadow-sm">
                        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger border-0 border-start border-4 border-danger shadow-sm">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>