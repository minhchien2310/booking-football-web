@model IEnumerable<DatSanBanh.Models.DatSan>
@{
    ViewData["Title"] = "Lịch sử đặt sân";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0"><i class="bi bi-clock-history text-success me-2"></i>Lịch Sử Đặt Sân Của Tôi</h4>
        <a asp-action="DatLich" class="btn btn-success btn-sm fw-semibold">
            <i class="bi bi-plus-circle me-1"></i> Đặt thêm sân mới
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <p class="text-muted mb-3">Bạn chưa có phiếu đặt sân nào.</p>
                <a asp-action="DatLich" class="btn btn-success">Đặt sân ngay</a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Mã phiếu</th>
                            <th>Sân bóng</th>
                            <th>Ngày đá</th>
                            <th>Khung giờ</th>
                            <th>Tổng tiền</th>
                            <th>Tiền cọc (30%)</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">#@item.MaDatSan</td>
                                <td class="fw-semibold">@item.MaSanNavigation?.TenSan</td>
                                <td>@item.NgayDat?.ToString("dd/MM/yyyy")</td>
                                <td><span class="badge bg-light text-dark border">@item.KhungGioText</span></td>
                                <td class="fw-bold text-success">@item.TongTien.ToString("N0")đ</td>
                                <td class="text-muted">@item.TienCoc.ToString("N0")đ</td>
                                <td>
                                    @if (item.TrangThai == "ChoThanhToan")
                                    {
                                        <span class="badge bg-warning text-dark">Chờ thanh toán cọc</span>
                                    }
                                    else if (item.TrangThai == "DaCoc")
                                    {
                                        <span class="badge bg-info text-dark">Đã cọc</span>
                                    }
                                    else if (item.TrangThai == "DaNhanSan")
                                    {
                                        <span class="badge bg-primary">Đã nhận sân</span>
                                    }
                                    else if (item.TrangThai == "HoanThanh")
                                    {
                                        <span class="badge bg-success">Hoàn thành</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Đã hủy</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (item.TrangThai == "ChoThanhToan")
                                    {
                                        <form asp-action="HuyDon" asp-route-id="@item.MaDatSan" method="post" class="d-inline"
                                              onsubmit="return confirm('Bạn muốn hủy phiếu đặt sân #@item.MaDatSan?');">
                                            <button type="submit" class="btn btn-outline-danger btn-sm">Hủy phiếu</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>