@model DatSanBanh.Models.SanBong

<!DOCTYPE html>
<html>
<head>
    <title>Quản lý Phiếu Thuê</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <div class="container py-4">
        <!-- Tiêu đề & Nút thêm căn giữa -->
        <div class="text-center mb-3">
            <h2 class="fw-bold">⚽ QUẢN LÝ Đặt SÂN BÓNG</h2>
            <a asp-action="them" class="btn btn-success fw-bold px-3 py-2 mt-2">
                ➕ Thêm Sân Mới (CREATE)
            </a>
        </div>

        <!-- Bảng thu nhỏ gọn căn giữa màn hình -->
        <div class="d-flex justify-content-center">
            <table class="table table-bordered align-middle text-center" style="max-width: 650px; border: 2px solid #6c757d;">
                <thead class="table-light fs-5 fw-bold" style="border-bottom: 2px solid #6c757d;">
                    <tr>
                        <th style="width: 10%;">ID</th>
                        <th style="width: 35%;">Tên Sân</th>
                        <th style="width: 20%;">Loại Sân</th>
                        <th style="width: 15%;">Giá Thuê</th>
                        <th style="width: 15%;">Trạng Thái</th>
                        <th style="width: 20%;">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        foreach (var item in ViewBag.sb)
                        {
                            <tr>
                                <td class="fw-bold">@item.Id</td>
                                <td class="text-start ps-3">@item.TenSan</td>
                                <td>@item.LoaiSan</td>
                                <td>@item.GiaThue.ToString("0")</td>
                                <td>@if (item.TrangThai == true)
                                {
                                    <span>Còn trống</span>
                                }
                                else
                                {
                                    <span>Đã đặt</span>
                                }
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center gap-1">
                                        <a asp-action="sua" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary text-dark border-secondary px-2">
                                             Sửa
                                        </a>
                                        <a asp-action="xoa" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary text-danger border-secondary px-2">
                                             Xóa
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>