@model DatSanBanh.Models.SanBong
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Sửa Sân Bóng</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <div class="container mt-4">
        <h1>Sửa thông tin sân bóng</h1>
        <form asp-action="sua" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="form-group mb-3">
                <label asp-for="TenSan" class="control-label">Tên sân</label>
                <input asp-for="TenSan" class="form-control" />
            </div>
            <div class="form-group mb-3">
                <label asp-for="LoaiSan" class="form-label fw-bold">Loại Sân</label>
                <select asp-for="LoaiSan" class="form-select">
                    <option value="Sân 5 người" selected="@(Model?.LoaiSan == "Sân 5 người")">Sân 5 người</option>
                    <option value="Sân 7 người" selected="@(Model?.LoaiSan == "Sân 7 người")">Sân 7 người</option>
                </select>
            </div>
            <div class="form-group mb-3">
                <label asp-for="GiaThue" class="control-label">Giá thuê</label>
                <input asp-for="GiaThue" type="number" asp-format="{0:0}" class="form-control" />
            </div>
            <div class="form-group mb-3">
                <label asp-for="TrangThai" class="control-label">Trạng thái</label>
                <select asp-for="TrangThai" asp-items="@ViewBag.TrangThaiList" class="form-select"></select>
            </div>
            <div class="form-group mt-3">
                <input type="submit" class="btn btn-primary" value="Lưu thay đổi" />
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </form>
    </div>
</body>
</html>