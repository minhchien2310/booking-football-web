@model DatSanBanh.Models.SanBong
@{
    Layout = null;
}
<html> 
<head> 
    <meta name="viewport" content="width=device-width" /> 
    <!-- Latest compiled and minified CSS --> 
    <link 
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" 
rel="stylesheet"> 
 
    <!-- Latest compiled JavaScript --> 
    <script 
src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script> 
 
</head> 
<body> 
    <div class="container"> 
        <form asp-action="them" method="post"> 
        <h2>Thêm Sân Bóng</h2>
        <div class="form-group">
        <div asp-validation-summary="ModelOnly" class="text-danger">
        <span>Các lỗi cần khắc phục:</span>
        </div>
        </div>
        <div class="form-group">
        <label asp-for="TenSan" class="form-label"></label>
        <input asp-for="TenSan" class="form-control" />
        <span asp-validation-for="TenSan" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
        <label asp-for="LoaiSan" class="form-label fw-bold">Loại Sân</label>
        <select asp-for="LoaiSan" class="form-select">
        <option value="Sân 5 người">Sân 5 người</option>
        <option value="Sân 7 người">Sân 7 người</option>
        </select>
        <span asp-validation-for="LoaiSan" class="text-danger"></span>
        </div>
        <div class="form-group">
        <label asp-for="GiaThue" class="control-label"></label>
        <input asp-for="GiaThue" type="number" class="form-control"/>
        <span asp-validation-for="GiaThue" class="text-danger"></span>
        </div>
        <div class="form-group">
        <label asp-for="TrangThai" class="form-label"></label>
        <select asp-for="TrangThai" class="form-select">
            <option value="true">Còn trống</option>
            <option value="false">Đã đặt</option>
        </select>
        <span asp-validation-for="TrangThai" class="text-danger"></span>
        </div>
        <div class="form-group mt-3">
        <input type="submit" class="btn btn-primary" value="Save" /><br/><br />
        
        </div>
        <div>
        <a asp-action="Index">Quay lại</a>
        </div>
        </form>
        </div>
        </body>
        </html>