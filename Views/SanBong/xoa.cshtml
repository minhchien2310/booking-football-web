@using DatSanBanh.Models
@model DatSanBanh.Models.SanBong
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Xóa sân bóng</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <div class="container mt-4">
        <h2>Xóa thông tin sân bóng</h2>
        <h3 class="text-danger">Bạn có chắc chắn muốn xóa sân bóng này không?</h3>
        
        <form asp-action="xoa" method="post">
            <input type="hidden" name="id" asp-for="Id" />

            <div class="form-group mb-3">
                <table class="table table-bordered">
                    <tr>
                        <th>Id</th>
                        <th>Tên Sân Bóng</th>
                        <th>Loại Sân</th>
                        <th>Giá Thuê</th>
                        <th>Trạng Thái</th>
                    </tr>
                    <tr>
                        <td>@Model.Id</td>
                        <td>@Model.TenSan</td>
                        <td>@Model.LoaiSan</td>
                        <td>@Model.GiaThue</td>
                        <td>@(Model.TrangThai == true ? "Còn trống" : "Đã đặt")</td>
                    </tr>
                </table>
            </div>

            <div class="form-group mb-3">
                <input type="submit" value="Xóa" class="btn btn-danger" />
            </div>

            <div>
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </form>
    </div>
</body>
</html>