@model DatSanBanh.Models.NguoiDung
@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                <!-- Phần đầu thẻ tông xanh đậm giống header card Sân 5A / 5B ngoài trang chủ -->
                <div class="card-header text-white py-3 px-4" style="background: linear-gradient(135deg, #102a1d 0%, #195e3a 100%);">
                    <span class="badge bg-success mb-1">THÀNH VIÊN MỚI</span>
                    <h4 class="mb-0 fw-bold">ĐĂNG KÝ TÀI KHOẢN</h4>
                    <small class="text-white-50">Tạo tài khoản để đặt sân nhanh & quản lý lịch thi đấu</small>
                </div>

                <!-- Phần thân form nền trắng sạch sẽ giống khung tìm kiếm ngoài trang chủ -->
                <div class="card-body p-4 bg-white">
                    <form asp-action="DangKy" asp-controller="TaiKhoan" method="post">

                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="HoTen" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="HoTen" class="form-control" placeholder="Ví dụ: Nguyễn Văn A" />
                            <span asp-validation-for="HoTen" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="nguyenvana@gmail.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SoDienThoai" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="SoDienThoai" class="form-control" placeholder="Số điện thoại" />
                            <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MatKhau" class="form-label fw-semibold text-dark small"></label>
                            <input asp-for="MatKhau" type="password" class="form-control" placeholder="Nhập mật khẩu (tối thiểu 6 ký tự)" />
                            <span asp-validation-for="MatKhau" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold text-dark small">Nhập lại mật khẩu</label>
                            <input name="XacNhanMatKhau" type="password" class="form-control" placeholder="Nhập lại mật khẩu vừa tạo" />
                        </div>

                        <button type="submit" class="btn btn-success w-100 py-2 fw-semibold">
                            Đăng ký tài khoản
                        </button>
                    </form>

                    <hr class="my-4 text-muted" />

                    <div class="text-center small">
                        <span class="text-muted">Bạn đã có tài khoản?</span>
                        <a asp-action="DangNhap" asp-controller="TaiKhoan" class="text-success fw-bold text-decoration-none ms-1">
                            Đăng nhập ngay
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>